<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Cover art — height set programmatically based on NA vs Japan mode -->
    <ImageView
        android:id="@+id/coverImage"
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@null" />

    <!-- Reflection container — scaleY=-1 applied in code, the layout masks the
         bottom edge to transparent so it sits correctly over the starfield -->
    <com.izzy2lost.neonsaturn.ReflectionFadeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/reflectionImage"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:alpha="0.38"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="@null" />
    </com.izzy2lost.neonsaturn.ReflectionFadeLayout>

    <TextView
        android:id="@+id/coverTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurface" />

</LinearLayout>
