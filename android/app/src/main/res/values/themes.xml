<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NeonSaturn" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/neon_saturn_bg</item>
        <item name="android:navigationBarColor">@color/neon_saturn_bg</item>
        <item name="colorPrimary">@color/neon_saturn_primary</item>
        <item name="colorOnPrimary">@color/neon_saturn_on_primary</item>
        <item name="colorSurface">@color/neon_saturn_surface</item>
        <item name="android:windowBackground">@color/neon_saturn_bg</item>
    </style>

    <!-- Applied to the header and library, whose contents sit on the always-dark
         starfield. Without this they would follow the app theme and end up as dark text
         on deep space in light mode. ThemeOverlay.Material3.Dark covers the surface and
         text roles but leaves colorPrimary alone, so the accent is set here too. -->
    <style name="ThemeOverlay.NeonSaturn.LibrarySurface" parent="ThemeOverlay.Material3.Dark">
        <item name="colorPrimary">@color/library_accent</item>
        <item name="colorSurface">@color/library_surface</item>
        <item name="android:colorBackground">@color/starfield_sky_bottom</item>
    </style>

    <!-- The launcher draws edge-to-edge over the animated starfield, so the system
         bars stay transparent and let it show through. LauncherActivity picks the
         matching light/dark bar icons at runtime. -->
    <style name="Theme.NeonSaturn.Launcher" parent="Theme.NeonSaturn">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.NeonSaturn.Emulator" parent="Theme.NeonSaturn">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="ThemeOverlay.NeonSaturn.QuickActionsDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

    <style name="ThemeOverlay.NeonSaturn.LibrarySettingsDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyLarge</item>
    </style>
</resources>
